{
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "app/api/transfers/[token]/files/[fileId]/complete/route.ts": {
      "maxDuration": 60
    },
    "app/api/cleanup/route.ts": {
      "maxDuration": 60
    }
  }
}
