# Environment variables for Flashdrop
# Copy to .env.local for local development. Never commit secrets.

# Neon PostgreSQL connection string (pooled)
DATABASE_URL=

# Neon Object Storage (S3-compatible). These are branch-scoped credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=temporary-files

# Public site URL used to generate share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for /api/cleanup (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
