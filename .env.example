# Environment variables for Flashdrop
# Copy to .env.local for local development. Never commit secrets.

# Neon PostgreSQL connection string (pooled)
DATABASE_URL=

# Vercel Blob read-write token
BLOB_READ_WRITE_TOKEN=

# Public site URL used to generate share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for /api/cleanup (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
